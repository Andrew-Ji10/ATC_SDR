- name: wfm
  id: analog_wfm_rcv
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: int(chan_rate / audio_rate)
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: chan_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 400]
    rotation: 0
    state: enabled
- name: xlate
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: freq - lo
    comment: ''
    decim: int(samp_rate / chan_rate)
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: firdes.low_pass(1.0, samp_rate, 100e3, 20e3)
    type: ccc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [676, 400]
    rotation: 0
    state: enabled

connections:
- [am_agc, '0', am_env, '0']
- [am_chan, '0', am_squelch, '0']
- [am_chan, '0', sig_pwr, '0']
- [am_dc, '0', am_lpf, '0']
- [am_env, '0', am_dc, '0']
- [am_lpf, '0', gate_am, '0']
- [am_squelch, '0', am_agc, '0']
- [gate_am, '0', mix, '1']
- [gate_nbfm, '0', mix, '2']
- [gate_wfm, '0', mix, '0']
- [mix, '0', vol, '0']
- [nbfm, '0', gate_nbfm, '0']
- [nbfm_chan, '0', nbfm_squelch, '0']
